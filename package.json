{
  "name": "qr-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generador de códigos QR totalmente personalizable: formas, colores, degradados, logo, exportación SVG/PNG y verificación de lectura en tiempo real.",
  "homepage": "https://qr-generator.soyjulian.dev",
  "author": "Julián Montañez Martos <julianmontanezmartos@gmail.com> (https://soyjulian.dev)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.96",
    "@iconify-json/solar": "^1.2.11",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
